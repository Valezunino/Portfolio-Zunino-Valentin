---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
---

<Layout>

<nav class="navbar">

  <a href="#">Inicio</a>

  <a href="#about">
    Sobre mí
  </a>

  <a href="#proyectos">
    Proyectos
  </a>

  <a href="#contacto">
    Contacto
  </a>

</nav>

<Welcome />

<section id="about" class="section">
  <h2>👨‍💻 Sobre mí</h2>

  <p>
    Soy Valentín Zunino, estudiante de Desarrollo de Software apasionado por
    la programación, el desarrollo web y la creación de soluciones digitales.
    Me enfoco en construir aplicaciones modernas, escalables y con una excelente
    experiencia de usuario.
  </p>

  <div class="skills">
    <span>HTML</span>
    <span>CSS</span>
    <span>Java</span>
    <span>Python</span>
    <span>Git</span>
    <span>GitHub</span>
    <span>Astro</span>
  </div>
</section>

<section id="proyectos" class="section">
  <h2>🚀 Proyectos Destacados</h2>

  <div class="project-grid">

    <div class="project-card">
      <h3>Web Turnos</h3>
      <p>
        Aplicación web desarrollada para la gestión eficiente de turnos,
        priorizando la organización y la usabilidad.
      </p>

      <a href="https://github.com/Valezunino/Web_Turnos" target="_blank">
        Ver proyecto →
      </a>
    </div>

    <div class="project-card">
      <h3>Proyecto DSW Backend</h3>
      <p>
        Desarrollo de la lógica de negocio y APIs para sistema de gestión.
      </p>

      <a href="https://github.com/Valezunino/Proyecto-DSW-Backend" target="_blank">
        Ver proyecto →
      </a>
    </div>

    <div class="project-card">
      <h3>Proyecto DSW Frontend</h3>
      <p>
        Interfaz moderna conectada a servicios backend con foco en experiencia
        de usuario.
      </p>

      <a href="https://github.com/Valezunino/Proyecto-DSW-Frontend" target="_blank">
        Ver proyecto →
      </a>
    </div>

    <div class="project-card">
      <h3>Tienda de Ropa Java</h3>
      <p>
        Sistema realizado aplicando programación orientada a objetos en Java.
      </p>

      <a href="https://github.com/Valezunino/Tienda-de-ropa-JAVA" target="_blank">
        Ver proyecto →
      </a>
    </div>

  </div>
</section>

<section id="contacto" class="section">
  <h2>📬 Contacto</h2>

  <p>
    ¿Tenés una propuesta o proyecto? Estoy disponible para colaborar.
  </p>

  <div class="contact-links">

    <a href="https://github.com/Valezunino" target="_blank">
      GitHub
    </a>

    <a href="https://www.linkedin.com/in/valentin-zunino-b50a883a3" target="_blank">
      LinkedIn
    </a>

    <a href="mailto:Valezunino2023@gmail.com">
      Email
    </a>

  </div>
</section>

</Layout>

<style>

.navbar{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  display:flex;
  gap:2rem;

  padding:1rem 2rem;

  border-radius:999px;

  backdrop-filter:blur(15px);

  background:
  rgba(255,255,255,.04);

  border:
  1px solid rgba(255,255,255,.08);

  z-index:1000;
}

.navbar a{
  text-decoration:none;
  color:white;
}

.navbar a:hover{
  color:#8b5cf6;
}

.section{
  max-width:1200px;
  margin:auto;
  padding:140px 20px;
}

.section h2{
  font-size:3rem;
  margin-bottom:2rem;
}

.section p{
  color:#9ca3af;
  line-height:1.8;
}

.projects-grid{
  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(300px,1fr));

  gap:2rem;
}

.card{
  background:
  rgba(255,255,255,.03);

  border:
  1px solid rgba(255,255,255,.08);

  border-radius:20px;

  padding:2rem;

  transition:.3s;
}

.card:hover{
  transform:translateY(-8px);

  border-color:#8b5cf6;

  box-shadow:
  0 20px 40px rgba(124,58,237,.15);
}

.techs{
  display:flex;
  flex-wrap:wrap;
  gap:1rem;
}

.techs span{
  padding:.8rem 1.4rem;

  border-radius:999px;

  background:
  rgba(124,58,237,.1);

  border:
  1px solid rgba(124,58,237,.3);
}

.contact-links{
  display:flex;
  gap:1rem;
  flex-wrap:wrap;
}

.contact-links a{
  text-decoration:none;

  padding:1rem 2rem;

  border-radius:12px;

  border:
  1px solid rgba(255,255,255,.08);

  transition:.3s;
}

.contact-links a:hover{
  background:#7c3aed;
  border-color:#7c3aed;
}
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 6rem 2rem;
}

.section h2 {
  font-size: 2.2rem;
  margin-bottom: 2rem;
}

.section p {
  color: #b4b4b4;
  line-height: 1.8;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 2rem;
}

.skills span {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 10px 18px;
  border-radius: 999px;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
  gap: 24px;
  margin-top: 2rem;
}

.project-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 24px;
  border-radius: 20px;
  transition: .3s;
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: #7c3aed;
}

.project-card h3 {
  margin-bottom: 1rem;
}

.project-card a {
  display: inline-block;
  margin-top: 1rem;
  color: #8b5cf6;
  text-decoration: none;
}

.contact-links {
  display: flex;
  gap: 20px;
  margin-top: 2rem;
  flex-wrap: wrap;
}

.contact-links a {
  padding: 14px 22px;
  background: #7c3aed;
  border-radius: 12px;
  color: white;
  text-decoration: none;
  transition: .3s;
}

.contact-links a:hover {
  transform: translateY(-3px);
}
</style>