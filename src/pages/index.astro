<script>
  document.querySelectorAll("[data-technology-wheel]").forEach((wheel) => {
    const orbit = wheel.querySelector("[data-technology-orbit]");
    const buttons = Array.from(wheel.querySelectorAll("[data-technology-button]"));
    const detail = wheel.querySelector(".technology-detail");
    const detailIcon = wheel.querySelector("[data-detail-icon]");
    const detailName = wheel.querySelector("[data-detail-name]");
    const detailType = wheel.querySelector("[data-detail-type]");

    if (!orbit || !detail || !detailIcon || !detailName || !detailType || buttons.length === 0) {
      return;
    }

    const angleStep = 360 / buttons.length;
    let activeIndex = 0;
    let rotation = 0;
    let hoverEnabled = true;
    let lastPointerX = 0;
    let lastPointerY = 0;

    const selectTechnology = (index) => {
      const button = buttons[index];
      if (!button) return;

      const targetRotation = -index * angleStep;
      const normalizedDelta = ((targetRotation - rotation + 540) % 360) - 180;
      rotation += normalizedDelta;
      activeIndex = index;

      wheel.style.setProperty("--wheel-rotation", `${rotation}deg`);
      wheel.style.setProperty("--counter-rotation", `${-rotation}deg`);

      buttons.forEach((item, itemIndex) => {
        item.setAttribute("aria-pressed", itemIndex === index ? "true" : "false");
      });

      const name = button.dataset.name ?? "";
      const type = button.dataset.type ?? "";
      const icon = button.dataset.icon ?? "";
      const needsContrast = button.dataset.needsContrast === "true";

      detailIcon.setAttribute("src", icon);
      detailIcon.setAttribute("alt", `Logo de ${name}`);
      detailName.textContent = name;
      detailType.textContent = type;
      detail.classList.toggle("needs-contrast", needsContrast);
    };

    wheel.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;

      const distance = Math.hypot(event.clientX - lastPointerX, event.clientY - lastPointerY);
      if (distance > 5) hoverEnabled = true;
    });

    buttons.forEach((button, index) => {
      button.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse" || !hoverEnabled) return;

        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        hoverEnabled = false;
        selectTechnology(index);
      });

      button.addEventListener("focus", () => selectTechnology(index));
      button.addEventListener("click", () => selectTechnology(index));

      button.addEventListener("keydown", (event) => {
        let nextIndex = activeIndex;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          nextIndex = (activeIndex + 1) % buttons.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          nextIndex = (activeIndex - 1 + buttons.length) % buttons.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = buttons.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        buttons[nextIndex].focus();
      });
    });
  });
</script>
