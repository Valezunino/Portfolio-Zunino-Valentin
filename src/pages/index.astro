---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";

const technologies = [
  {
    name: "JavaScript",
    type: "Lenguaje de programación",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg",
  },
  {
    name: "HTML5",
    type: "Lenguaje de marcado",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg",
  },
  {
    name: "CSS3",
    type: "Lenguaje de estilos",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg",
  },
  {
    name: "Java",
    type: "Lenguaje de programación",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg",
  },
  {
    name: "Python",
    type: "Lenguaje de programación",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg",
  },
  {
    name: "Astro",
    type: "Framework web",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg",
  },
  {
    name: "Spring Boot",
    type: "Framework backend",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg",
  },
  {
    name: "PostgreSQL",
    type: "Base de datos",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg",
  },
  {
    name: "Firebase",
    type: "Plataforma backend",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/firebase/firebase-original.svg",
  },
  {
    name: "Git",
    type: "Control de versiones",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg",
  },
  {
    name: "GitHub",
    type: "Plataforma de desarrollo",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg",
    needsContrast: true,
  },
  {
    name: "Vercel",
    type: "Plataforma de despliegue",
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vercel/vercel-original.svg",
    needsContrast: true,
  },
];

const projects = [
  {
    title: "Daniel Justiniano Fotografía",
    category: "Galería y venta online",
    description:
      "Plataforma para organizar, proteger y vender fotografías de eventos, con panel de administración, pagos mediante Mercado Pago y descarga segura de originales.",
    technologies: ["Next.js", "TypeScript", "PostgreSQL", "Mercado Pago"],
    repository: "https://github.com/Valezunino/Pagina-web-Fotografia",
    liveUrl: "https://daniel-justiniano-vercel-listo.vercel.app",
  },
  {
    title: "TechManager",
    category: "Sistema de gestión empresarial",
    description:
      "Aplicación full stack para administrar productos tecnológicos, stock, categorías, marcas, usuarios y roles, con dashboard y autenticación segura mediante JWT.",
    technologies: ["Java", "Spring Boot", "PostgreSQL", "JavaScript"],
    repository: "https://github.com/Valezunino/TechManager",
    liveUrl: "https://techmanager-eight.vercel.app",
  },
  {
    title: "Web Turnos",
    category: "Gestión y organización",
    description:
      "Aplicación desarrollada para centralizar la gestión de turnos e información operativa, priorizando una navegación clara y una experiencia de uso sencilla.",
    technologies: ["Python", "Tkinter", "MySQL"],
    repository: "https://github.com/Valezunino/Web_Turnos",
    liveUrl: null,
  },
  {
    title: "Tienda de Ropa",
    category: "Gestión de productos",
    description:
      "Sistema para administrar un catálogo de indumentaria, con búsqueda, filtros, estadísticas, control de stock y operaciones de alta y edición de productos.",
    technologies: ["HTML5", "CSS3", "JavaScript", "Python"],
    repository: "https://github.com/Valezunino/Tienda-de-ropa",
    liveUrl: "https://tienda-de-ropa-tau.vercel.app",
  },
];
---

<Layout>

<nav class="navbar">

  <a href="#">Inicio</a>

  <a href="#about">
    Sobre mí
  </a>

  <a href="#proyectos">
    Proyectos
  </a>

  <a href="#contacto">
    Contacto
  </a>

</nav>

<Welcome />

<section id="about" class="section">
  <h2>👨‍💻 Sobre mí</h2>

  <p>
    Soy Valentín Zunino, estudiante de Desarrollo de Software apasionado por
    la programación, el desarrollo web y la creación de soluciones digitales.
    Me enfoco en construir aplicaciones modernas, escalables y con una excelente
    experiencia de usuario.
  </p>

  <div class="skills-showcase">
    <div class="skills-intro">
      <span class="skills-kicker">Stack tecnológico</span>
      <h3>Mis conocimientos</h3>
      <p id="wheel-instructions">
        Pasá el cursor, usá el teclado o tocá un logo para conocer cada tecnología.
      </p>
    </div>

    <div
      class="technology-wheel"
      data-technology-wheel
      aria-label="Rueda interactiva de tecnologías"
      aria-describedby="wheel-instructions"
    >
      <div class="wheel-track" aria-hidden="true"></div>

      <div class="technology-orbit" data-technology-orbit>
        {technologies.map((technology, index) => (
          <button
            class="technology-button"
            type="button"
            style={`--angle: ${(360 / technologies.length) * index}deg`}
            data-technology-button
            data-index={index}
            data-name={technology.name}
            data-type={technology.type}
            data-icon={technology.icon}
            data-needs-contrast={technology.needsContrast ? "true" : "false"}
            aria-label={`Seleccionar ${technology.name}: ${technology.type}`}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class:list={["technology-logo-frame", { "needs-contrast": technology.needsContrast }]}>
              <img
                src={technology.icon}
                alt=""
                width="52"
                height="52"
                decoding="async"
              />
            </span>
          </button>
        ))}
      </div>

      <div class="technology-detail" role="status" aria-live="polite" aria-atomic="true">
        <span class="detail-glow" aria-hidden="true"></span>
        <img
          data-detail-icon
          src={technologies[0].icon}
          alt="Logo de JavaScript"
          width="88"
          height="88"
        />
        <strong data-detail-name>{technologies[0].name}</strong>
        <span data-detail-type>{technologies[0].type}</span>
      </div>
    </div>
  </div>
</section>

<section id="proyectos" class="section">
  <div class="projects-heading">
    <div>
      <span class="projects-kicker">Trabajo seleccionado</span>
      <h2>🚀 Proyectos Destacados</h2>
    </div>

    <p>
      Soluciones que combinan desarrollo, diseño y lógica de negocio para resolver
      necesidades concretas.
    </p>
  </div>

  <div class="project-grid">
    {projects.map((project, index) => (
      <article class="project-card">
        <div class="project-card-top">
          <span class="project-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class:list={["project-status", { "is-live": project.liveUrl }]}>
            <span aria-hidden="true"></span>
            {project.liveUrl ? "Proyecto publicado" : "Código disponible"}
          </span>
        </div>

        <div class="project-copy">
          <span class="project-category">{project.category}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>

        <ul class="project-techs" aria-label={`Tecnologías utilizadas en ${project.title}`}>
          {project.technologies.map((technology) => <li>{technology}</li>)}
        </ul>

        <div class="project-actions">
          {project.liveUrl && (
            <a
              class="project-link project-link-primary"
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver ${project.title} publicado`}
            >
              Ver proyecto
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          )}

          <a
            class="project-link project-link-secondary"
            href={project.repository}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver el código de ${project.title} en GitHub`}
          >
            Ver código
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4" />
              <path d="M8 19c-3 .9-3-1.5-4-2" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<section id="contacto" class="section contact-section">
  <div class="contact-shell">
    <div class="contact-intro">
      <div class="contact-heading-top">
        <span class="contact-kicker">Contacto</span>
        <span class="availability-badge">
          <span aria-hidden="true"></span>
          Disponible para oportunidades
        </span>
      </div>

      <h2>Construyamos algo <span>juntos.</span></h2>

      <p>
        Estoy abierto a oportunidades laborales, colaboraciones y proyectos freelance.
        Si buscás una persona responsable, curiosa y enfocada en resolver problemas,
        conversemos.
      </p>

      <a class="contact-primary" href="mailto:Valezunino2023@gmail.com">
        Escribime por email
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="contact-methods" aria-label="Medios de contacto">
      <a
        class="contact-card"
        href="mailto:Valezunino2023@gmail.com"
        aria-label="Enviar un correo electrónico a Valentín"
      >
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </span>
        <span class="contact-card-copy">
          <span>Email</span>
          <strong>Valezunino2023@gmail.com</strong>
          <small>La forma más directa de contactarme</small>
        </span>
        <svg class="contact-arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>

      <a
        class="contact-card"
        href="https://www.linkedin.com/in/valentin-zunino-b50a883a3"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver el perfil de Valentín en LinkedIn"
      >
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
            <path d="M2 9h4v12H2z" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </span>
        <span class="contact-card-copy">
          <span>LinkedIn</span>
          <strong>Valentín Zunino</strong>
          <small>Experiencia, formación y perfil profesional</small>
        </span>
        <svg class="contact-arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>

      <a
        class="contact-card"
        href="https://github.com/Valezunino"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver los repositorios de Valentín en GitHub"
      >
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4" />
            <path d="M8 19c-3 .9-3-1.5-4-2" />
          </svg>
        </span>
        <span class="contact-card-copy">
          <span>GitHub</span>
          <strong>@Valezunino</strong>
          <small>Proyectos, código y trabajo reciente</small>
        </span>
        <svg class="contact-arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>
    </div>
  </div>
</section>

</Layout>

<style>

.navbar{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);

  display:flex;
  gap:2rem;

  padding:1rem 2rem;

  border-radius:999px;

  backdrop-filter:blur(15px);

  background:
  rgba(255,255,255,.04);

  border:
  1px solid rgba(255,255,255,.08);

  z-index:1000;
}

.navbar a{
  text-decoration:none;
  color:white;
}

.navbar a:hover{
  color:#8b5cf6;
}

.section{
  max-width:1200px;
  margin:auto;
  padding:140px 20px;
}

.section h2{
  font-size:3rem;
  margin-bottom:2rem;
}

.section p{
  color:#9ca3af;
  line-height:1.8;
}

.projects-grid{
  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(300px,1fr));

  gap:2rem;
}

.card{
  background:
  rgba(255,255,255,.03);

  border:
  1px solid rgba(255,255,255,.08);

  border-radius:20px;

  padding:2rem;

  transition:.3s;
}

.card:hover{
  transform:translateY(-8px);

  border-color:#8b5cf6;

  box-shadow:
  0 20px 40px rgba(124,58,237,.15);
}

.techs{
  display:flex;
  flex-wrap:wrap;
  gap:1rem;
}

.techs span{
  padding:.8rem 1.4rem;

  border-radius:999px;

  background:
  rgba(124,58,237,.1);

  border:
  1px solid rgba(124,58,237,.3);
}

.contact-links{
  display:flex;
  gap:1rem;
  flex-wrap:wrap;
}

.contact-links a{
  text-decoration:none;

  padding:1rem 2rem;

  border-radius:12px;

  border:
  1px solid rgba(255,255,255,.08);

  transition:.3s;
}

.contact-links a:hover{
  background:#7c3aed;
  border-color:#7c3aed;
}
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 6rem 2rem;
}

.section h2 {
  font-size: 2.2rem;
  margin-bottom: 2rem;
}

.section p {
  color: #b4b4b4;
  line-height: 1.8;
}

.skills-showcase {
  display: grid;
  grid-template-columns: minmax(220px, 0.7fr) minmax(430px, 1.3fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
  margin-top: clamp(3rem, 7vw, 5.5rem);
  padding: clamp(1.25rem, 3vw, 2.5rem);
  overflow: hidden;
  background:
    radial-gradient(circle at 75% 50%, rgba(124, 58, 237, 0.18), transparent 38%),
    rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(167, 139, 250, 0.16);
  border-radius: 32px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.skills-intro {
  position: relative;
  z-index: 2;
}

.skills-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  color: #a78bfa;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.skills-kicker::before {
  width: 24px;
  height: 1px;
  content: "";
  background: #8b5cf6;
  box-shadow: 0 0 12px #8b5cf6;
}

.skills-intro h3 {
  margin: 0 0 1rem;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1;
}

.skills-intro p {
  max-width: 34rem;
  margin: 0;
}

.technology-wheel {
  --wheel-size: min(47vw, 520px);
  --orbit-radius: calc(var(--wheel-size) * 0.41);
  --wheel-rotation: 0deg;
  --counter-rotation: 0deg;
  position: relative;
  width: var(--wheel-size);
  aspect-ratio: 1;
  justify-self: center;
  isolation: isolate;
}

.technology-wheel::before {
  position: absolute;
  inset: 15%;
  z-index: -1;
  content: "";
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 68%);
  filter: blur(22px);
}

.wheel-track {
  position: absolute;
  inset: 8.5%;
  border: 1px solid rgba(167, 139, 250, 0.28);
  border-radius: 50%;
  box-shadow:
    0 0 45px rgba(124, 58, 237, 0.14),
    inset 0 0 45px rgba(124, 58, 237, 0.08);
}

.wheel-track::before,
.wheel-track::after {
  position: absolute;
  inset: -5px;
  content: "";
  border: 1px solid transparent;
  border-top-color: rgba(196, 181, 253, 0.72);
  border-bottom-color: rgba(124, 58, 237, 0.38);
  border-radius: inherit;
}

.wheel-track::after {
  inset: 10px;
  border-top-color: transparent;
  border-right-color: rgba(139, 92, 246, 0.3);
  transform: rotate(25deg);
}

.technology-orbit {
  position: absolute;
  inset: 0;
  transform: rotate(var(--wheel-rotation));
  transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.technology-button {
  position: absolute;
  top: 50%;
  left: 50%;
  width: clamp(48px, 5.4vw, 64px);
  aspect-ratio: 1;
  padding: 0;
  color: inherit;
  background: transparent;
  border: 0;
  border-radius: 50%;
  cursor: pointer;
  touch-action: manipulation;
  transform:
    translate(-50%, -50%)
    rotate(var(--angle))
    translateY(calc(-1 * var(--orbit-radius)))
    rotate(calc(-1 * var(--angle)));
}

.technology-logo-frame {
  position: relative;
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  padding: 12px;
  background: rgba(13, 10, 26, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  transform: rotate(var(--counter-rotation));
  transition:
    transform 350ms ease,
    border-color 350ms ease,
    background 350ms ease,
    box-shadow 350ms ease;
}

.technology-logo-frame img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.technology-logo-frame.needs-contrast img,
.technology-detail.needs-contrast img {
  filter: grayscale(1) brightness(0) invert(1);
}

.technology-button:hover .technology-logo-frame,
.technology-button:focus-visible .technology-logo-frame,
.technology-button[aria-pressed="true"] .technology-logo-frame {
  background: rgba(35, 22, 67, 0.98);
  border-color: #a78bfa;
  box-shadow:
    0 0 0 5px rgba(139, 92, 246, 0.12),
    0 0 28px rgba(139, 92, 246, 0.46);
}

.technology-button[aria-pressed="true"] .technology-logo-frame {
  transform: rotate(var(--counter-rotation)) scale(1.14);
}

.technology-button:focus-visible {
  outline: 3px solid #ddd6fe;
  outline-offset: 5px;
}

.technology-detail {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 45%;
  aspect-ratio: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 0.45rem;
  padding: 1.25rem;
  overflow: hidden;
  text-align: center;
  background: linear-gradient(145deg, rgba(30, 21, 53, 0.97), rgba(9, 7, 18, 0.98));
  border: 1px solid rgba(167, 139, 250, 0.42);
  border-radius: 50%;
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 0 45px rgba(124, 58, 237, 0.18);
  transform: translate(-50%, -50%);
}

.detail-glow {
  position: absolute;
  top: -35%;
  width: 80%;
  aspect-ratio: 1;
  background: rgba(139, 92, 246, 0.25);
  border-radius: 50%;
  filter: blur(30px);
  pointer-events: none;
}

.technology-detail img {
  z-index: 1;
  width: clamp(44px, 7vw, 78px);
  height: clamp(44px, 7vw, 78px);
  margin-bottom: 0.25rem;
  object-fit: contain;
}

.technology-detail strong {
  z-index: 1;
  font-size: clamp(1.05rem, 2.1vw, 1.55rem);
  line-height: 1.1;
}

.technology-detail > span:last-child {
  z-index: 1;
  color: #c4b5fd;
  font-size: clamp(0.66rem, 1.2vw, 0.8rem);
  line-height: 1.25;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
  margin-top: 3rem;
}

.projects-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
  align-items: end;
  gap: 3rem;
}

.projects-heading h2 {
  margin: 0;
}

.projects-heading > p {
  margin: 0 0 0.25rem;
}

.projects-kicker {
  display: block;
  margin-bottom: 0.8rem;
  color: #a78bfa;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.project-card {
  position: relative;
  display: flex;
  min-height: 390px;
  flex-direction: column;
  padding: clamp(1.5rem, 3vw, 2rem);
  overflow: hidden;
  background:
    radial-gradient(circle at 90% 5%, rgba(124, 58, 237, 0.16), transparent 34%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
